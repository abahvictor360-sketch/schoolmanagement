# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Apex domain that tenant subdomains hang off, e.g. schoolhub.app.
# Leave unset to run with the explicit school switcher instead of subdomains.
NEXT_PUBLIC_ROOT_DOMAIN=

# Payment gateway secret keys. A school picks its provider in Settings, and
# only the provider it picks needs its key set. Read on the server only, and
# never stored against a school.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
REMITA_API_KEY=
STRIPE_SECRET_KEY=

# --- Platform billing -------------------------------------------------------
# What schools pay the operator to use SchoolHub. This is the OPERATOR's own
# merchant account, not a school's: subscription money goes to you, fee money
# goes to them.
#
# Set these BEFORE the first trial ends. The read-only gate lives in Postgres
# and cannot see this file, so an unconfigured gateway does not disable it: a
# school would simply lapse with no way to pay. Until it is configured, extend
# a school by hand with select set_school_subscription(...).
PLATFORM_BILLING_PROVIDER=paystack
PLATFORM_BILLING_PUBLIC_KEY=
# Remita only.
PLATFORM_BILLING_MERCHANT_CODE=
PLATFORM_BILLING_SERVICE_TYPE_ID=
